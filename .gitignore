# ---- Handoff / transfer docs (never commit, delete after use) ----
handoff*.md
HANDOFF*.md

# ---- Secrets & credentials — NEVER COMMIT (policy in AGENTS.md) ----
.env*
**/*.env
**/*.key
*.pem
*.keystore
*.jks
dev_secrets*.json
config/dev/
credentials*.json
*token*.txt
account*.txt

# ---- Flutter / Dart ----
.dart_tool/
# ---- fvm (Flutter version manager): pin in .fvmrc (committed),
# ---- local SDK link + caches are machine-specific ----
.fvm/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
app.*.symbols
app.*.map.json
/android/app/debug
/android/app/profile
/android/app/release

# ---- IDE / tooling ----
.idea/
*.iml
.vscode/
# Claude Code project dir: ignore local settings, keep the committed skill link
.claude/*
!.claude/skills/
*.log
.DS_Store

# ---- Platform build artifacts ----
ios/Pods/
ios/.symlinks/
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral
ios/Flutter/flutter_export_environment.sh
ios/ServiceDefinitions.json
ios/Runner/GeneratedPluginRegistrant.h
ios/Runner/GeneratedPluginRegistrant.m
macos/Flutter/ephemeral
macos/Flutter/GeneratedPluginRegistrant.swift
# Flutter-{Debug,Release,Profile}.xcconfig are committed templates, NOT
# generated — ignoring them broke fresh-clone CI builds (the runner configs
# hard-include them; only ephemeral/ + registrant are tool-generated).
linux/flutter/ephemeral
windows/flutter/ephemeral
android/.gradle/
android/local.properties
android/key.properties
**/xcuserdata/
**/DerivedData/
# Distributable artifacts (CI builds these; never commit them)
*.apk
*.ipa
*.dmg
*.app.zip

# FVM Version Cache
.fvm/